# Secrets are referenced, never written: the host resolves each pointer from
# Secrets Manager into a scratch file that is deleted after "compose up".
# CORE_ROOT_SECRET_ARN is supplied by the platform.
MONGO_INITDB_ROOT_USERNAME=__FROM_SECRET__:CORE_ROOT_SECRET_ARN:username
MONGO_INITDB_ROOT_PASSWORD=__FROM_SECRET__:CORE_ROOT_SECRET_ARN:root_password
