# Secrets are referenced, never written: the host resolves each pointer from
# Secrets Manager into a scratch file that is deleted after "compose up".
# CORE_ROOT_SECRET_ARN is supplied by the platform.
MYSQL_ROOT_PASSWORD=__FROM_SECRET__:CORE_ROOT_SECRET_ARN:root_password

# root may connect only from inside the container, which is how provision.sh
# uses it. The image's default (%) would expose it on the published port.
MYSQL_ROOT_HOST=localhost
