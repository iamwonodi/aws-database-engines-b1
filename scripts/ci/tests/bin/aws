#!/usr/bin/env bash
# Fake aws for offline tests. Every call is appended to $FAKE_LOG.
#   FAKE_CONTRACT         value returned by "ssm get-parameter" (unset: ParameterNotFound)
#   FAKE_ECR_REPO_EXISTS  "true": describe-repositories succeeds
#   FAKE_ECR_TAGS         space-separated tags describe-images reports as existing
#   FAKE_S3_DIR           "s3 sync" and "s3 cp" copy into this directory (bucket root)
#   FAKE_S3_FAIL          makes every "s3 ..." call fail
#   FAKE_SEND_FAIL        makes "ssm send-command" fail
#   FAKE_INVOCATIONS_DIR  1.json, 2.json ...: one per "list-command-invocations" call, the last repeating
[[ -n "${FAKE_LOG:-}" ]] && printf 'aws %s\n' "$*" >> "${FAKE_LOG}"
case "$1 $2" in
  "ssm get-parameter")
    [[ -n "${FAKE_CONTRACT:-}" ]] && { printf '%s\n' "${FAKE_CONTRACT}"; exit 0; }
    echo "An error occurred (ParameterNotFound) when calling the GetParameter operation" >&2; exit 254 ;;
  "ecr get-login-password") echo "fake-token"; exit 0 ;;
  "ecr describe-repositories")
    [[ "${FAKE_ECR_REPO_EXISTS:-}" == "true" ]] && exit 0; exit 254 ;;
  "ecr create-repository") exit 0 ;;
  "ecr describe-images")
    tag=""; for a in "$@"; do [[ "$a" == imageTag=* ]] && tag="${a#imageTag=}"; done
    for t in ${FAKE_ECR_TAGS:-}; do [[ "$t" == "$tag" ]] && exit 0; done
    exit 254 ;;
  "s3 sync")
    [[ -n "${FAKE_S3_FAIL:-}" ]] && { echo "upload failed" >&2; exit 1; }
    src="$3"; dst="${4#s3://}"; dst="${FAKE_S3_DIR}/${dst#*/}"
    [[ " $* " == *" --delete "* ]] && rm -rf "${dst}"
    mkdir -p "${dst}"; cp -R "${src}/." "${dst}/"; exit 0 ;;
  "s3 cp")
    [[ -n "${FAKE_S3_FAIL:-}" ]] && { echo "upload failed" >&2; exit 1; }
    src="$3"; dst="${4#s3://}"; dst="${FAKE_S3_DIR}/${dst#*/}"
    mkdir -p "$(dirname "${dst}")"; cp "${src}" "${dst}"; exit 0 ;;
  "ssm send-command")
    [[ -n "${FAKE_SEND_FAIL:-}" ]] && { echo "AccessDeniedException" >&2; exit 254; }
    echo "cmd-0123"; exit 0 ;;
  "ssm list-command-invocations")
    counter="${FAKE_INVOCATIONS_DIR}/.n"; n=$(( $(cat "${counter}" 2>/dev/null || echo 0) + 1 )); echo "${n}" > "${counter}"
    file="${FAKE_INVOCATIONS_DIR}/${n}.json"
    [[ -f "${file}" ]] || file="$(ls "${FAKE_INVOCATIONS_DIR}"/*.json | sort -V | tail -1)"
    cat "${file}"; exit 0 ;;
esac
exit 0
